{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tampiloka-commerce-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "DEMO_MODE": "true", "TURSO_DATABASE_URL": "libsql://tampiloka-commerce-demo-soezyxstt.aws-ap-south-1.turso.io" },
  "routes": [{ "pattern": "ecommerce.tampiloka.site", "custom_domain": true }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 * * * *"] }
}
