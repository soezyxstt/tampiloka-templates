{
  "name": "@tampiloka/template-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "dev:api": "node scripts/dev.mjs api",
    "build": "vite build && node scripts/build-worker.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/backend.test.mjs tests/local-env.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:language": "node tests/language-browser.mjs",
    "db:local": "node scripts/dev.mjs migrate",
    "db:remote": "tampiloka-db migrate",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:demo": "pnpm build && wrangler deploy --config wrangler.demo.jsonc"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-radio-group": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tampiloka/shared-utils": "workspace:*",
    "@tampiloka/theme-engine": "workspace:*",
    "@tampiloka/ui-core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.553.0",
    "motion": "12.43.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "tailwindcss": "4.1.11",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  }
}
