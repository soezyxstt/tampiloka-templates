{
  "name": "@tampiloka/template-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "dev:api": "wrangler dev --port 8787 --local --persist-to .data --var DEMO_MODE:true",
    "build": "vite build && node scripts/build-worker.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/backend.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --persist-to .data",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:demo": "pnpm build && wrangler deploy --config wrangler.demo.jsonc"
  },
  "dependencies": {
    "@tampiloka/ui-core": "workspace:*",
    "@tampiloka/theme-engine": "workspace:*",
    "@tampiloka/shared-utils": "workspace:*",
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.553.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  }
}
