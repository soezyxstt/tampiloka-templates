{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tampiloka-operations-client",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "DEMO_MODE": "false", "BACKUP_ENABLED": "false" },
  // Opt in only after provisioning a private R2 bucket and choosing retention.
  // Add BACKUP_RETENTION_DAYS (1..3650), BACKUP_CLEANUP_LIMIT (1..100), and
  // BACKUP_ENABLED="true" to vars. Provision BACKUP_SECRET as a secret.
  // "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "<private-installation-backups>" }],
  // Example enabled schedule: { "crons": ["*/10 * * * *"] } (UTC).
  "triggers": { "crons": [] },
  "durable_objects": { "bindings": [{ "name": "OPERATIONS", "class_name": "OperationsStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OperationsStore"] }],
  "observability": { "enabled": true }
}
