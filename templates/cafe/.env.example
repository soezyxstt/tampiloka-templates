# Start a local demo with: npm run demo
# This uses a dedicated PGlite database, fictional users and simulated payments.
# Demo mode is explicit; missing SQL credentials never enables it automatically.
# CAFE_DEMO_DB=1

# Optional override. By default each configured outlet uses:
# .local/<outletSlug>/cafe-db
# CAFE_DEMO_DATA_DIR=.local/my-client/cafe-db

# Use 1 on a new database to keep menu/tables but start without sample orders.
# It does not erase an existing database. Reset is an explicit staff action.
# CAFE_DEMO_EMPTY=1

# Catalog-only serves public content/*.json without these variables.
# Live ordering/staff operation needs server authentication, signed customer
# sessions and a verified payment adapter before enabling production transactions.
# Never point the demo seeder at a real client database.
# PostgreSQL: use the existing PostgreSQL migration workflow.
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/cafe
# Optional PostgreSQL connection settings:
# SQL_HOST=localhost
# SQL_DB_NAME=cafe
# SQL_USER=cafe_app
# SQL_PASSWORD=
# SQL_ADMIN_USER=
# SQL_ADMIN_PASSWORD=

# Media API: generate a unique random secret of at least 32 bytes. Keep it private.
# CAFE_MEDIA_SECRET=
# OBJECT_STORAGE_PROVIDER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_URL=
# Alternatively OBJECT_STORAGE_PROVIDER=uploadthing and set UPLOADTHING_TOKEN.
# UPLOADTHING_TOKEN=
# For a new Turso or D1 database, set DATABASE_PROVIDER accordingly, then run
# npm run db:migrate:sqlite and npm run db:seed:sqlite after configuring the client catalog.
# D1 uses a bounded snapshot; see docs/runtime.md.
# DATABASE_PROVIDER=turso
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# Optional server-only attendance private storage; registering trusted auth and policy is also required.
# ATTENDANCE_S3_ENDPOINT=
# ATTENDANCE_S3_REGION=auto
# ATTENDANCE_S3_BUCKET=
# ATTENDANCE_S3_ACCESS_KEY_ID=
# ATTENDANCE_S3_SECRET_ACCESS_KEY=
# ATTENDANCE_S3_SESSION_TOKEN=
# ATTENDANCE_RETENTION_SECONDS=2592000
