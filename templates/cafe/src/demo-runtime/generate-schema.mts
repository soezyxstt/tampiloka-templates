/** Build-time only. Regenerate after changing src/db/schema.ts. */
import { createHash } from 'node:crypto';
import { writeFile } from 'node:fs/promises';
import { PGlite } from '@electric-sql/pglite';
import { drizzle } from 'drizzle-orm/pglite';
import { pushSchema } from 'drizzle-kit/api';
import * as schema from '../db/schema.ts';

const client = new PGlite();
try {
  const migration = await pushSchema(schema, drizzle(client));
  if (migration.hasDataLoss) throw new Error('An empty browser database must not require a destructive migration.');
  const sql = migration.statementsToExecute.join('\n');
  const revision = createHash('sha256').update(sql).digest('hex').slice(0, 16);
  await writeFile(new URL('./schema.generated.ts', import.meta.url), [
    '// Generated by generate-schema.mts from src/db/schema.ts. Do not hand-edit.',
    '// A new revision gets a separate local demo database; this is not a live-data migration.',
    `export const BROWSER_SCHEMA_REVISION = ${JSON.stringify(revision)};`,
    `export const BROWSER_SCHEMA_SQL = ${JSON.stringify(sql)};`,
    '',
  ].join('\n'));
  console.log(`Browser demo schema: ${migration.statementsToExecute.length} statements, revision ${revision}.`);
} finally {
  await client.close();
}
