{
  "name": "@tampiloka/template-cafe",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "demo:prepare": "node --experimental-strip-types scripts/prepare-demo-db.ts",
    "demo": "node scripts/run-demo.mjs",
    "cafe": "node scripts/cafe.mjs",
    "typecheck": "tsc --noEmit",
    "test:config": "node --test scripts/cafe-config.test.mjs",
    "test:media": "node --test src/media/media.test.mjs src/db/provider.test.mjs",
    "test:domain": "node --experimental-strip-types --test src/domain/rules.test.ts src/domain/capabilities.test.ts src/domain/order-billing.test.ts lib/reporting.test.ts",
    "test": "npm run test:config && npm run test:media && npm run test:catalog && npm run test:domain && npm run test:integration && npm run test:ui-contracts && npm run test:sqlite",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 src/db/service.integration.test.ts src/db/service.lifecycle.test.ts",
    "test:presets": "node tests/preset-integration.mjs",
    "test:browser": "node tests/browser-workflows.mjs",
    "test:catalog": "node --experimental-strip-types --test src/catalog/static-catalog.test.ts src/catalog/sample-menu.test.ts src/db/sample-photos.test.ts lib/system-messages.test.ts",
    "catalog:validate": "node --experimental-strip-types scripts/validate-catalog.mjs",
    "catalog:export": "node --experimental-strip-types scripts/export-catalog.mjs",
    "demos:dev": "vite --config demos/vite.config.mts",
    "demos:build": "vite build --config demos/vite.config.mts",
    "demos:preview": "vite preview --config demos/vite.config.mts",
    "demos:deploy": "npm run demos:build && wrangler pages deploy dist-demos --project-name tampiloka-cafe-demos",
    "test:demo-runtime": "node --experimental-strip-types --test --test-concurrency=1 tests/browser-runtime-coordination.test.mjs tests/browser-runtime-order-notifications.test.mjs tests/browser-runtime-crypto.test.mjs tests/browser-runtime-schema.test.mjs tests/browser-runtime-durability.test.mjs tests/browser-runtime-scenarios.test.mjs",
    "test:demo-browser": "node --experimental-strip-types tests/demos-browser.mjs",
    "test:language-browser": "node tests/language-browser.mjs",
    "test:demo-lifecycle": "node --experimental-strip-types tests/demos-lifecycle.mjs",
    "test:demo-all": "node scripts/demos-verify.mjs",
    "test:ui-contracts": "node --test tests/ui-contracts.test.mjs",
    "db:migrate:sqlite": "node --experimental-strip-types scripts/migrate-sqlite.ts",
    "test:sqlite": "node --experimental-strip-types --test src/db/sqlite.test.mjs",
    "db:seed:sqlite": "node --experimental-strip-types scripts/seed-client-sqlite.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tampiloka/storage": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "pg": "^8.23.1",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@noble/hashes": "2.4.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tampiloka/ui-core": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "playwright": "1.56.1",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "cafe": "scripts/cafe.mjs"
  }
}
