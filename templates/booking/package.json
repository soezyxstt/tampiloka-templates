{
  "name": "@tampiloka/template-booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs --demo",
    "dev:client": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:remote": "node scripts/migrate.mjs --remote",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:demo": "pnpm build:demo && wrangler deploy --config wrangler.demo.jsonc"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@tampiloka/ui-core": "workspace:*",
    "jsqr": "1.4.0",
    "lucide-react": "0.553.0",
    "motion": "12.43.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tampiloka/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  }
}
