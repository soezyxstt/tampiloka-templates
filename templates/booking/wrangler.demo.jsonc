{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tampiloka-booking-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": { "DEMO_MODE": "true" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tampiloka-booking-demo",
      "database_id": "c7a803d3-5f89-4091-8ae9-06bfa16ce279",
      "migrations_dir": "migrations",
    },
  ],
  "routes": [{ "pattern": "booking.tampiloka.site", "custom_domain": true }],
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
}
