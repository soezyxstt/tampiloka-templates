{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tampiloka-booking-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": { "DEMO_MODE": "true", "TURSO_DATABASE_URL": "libsql://tampiloka-booking-demo-soezyxstt.aws-ap-south-1.turso.io" },
  "routes": [{ "pattern": "booking.tampiloka.site", "custom_domain": true }],
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
}
