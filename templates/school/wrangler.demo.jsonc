{
  "name": "tampiloka-school-demo",
  "main": "dist-worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "school.tampiloka.site", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "DEMO_MODE": "true", "TURSO_DATABASE_URL": "libsql://tampiloka-school-demo-soezyxstt.aws-ap-south-1.turso.io" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tampiloka-school-demo-media" }],
  "triggers": { "crons": ["0 3 * * *"] }
}
