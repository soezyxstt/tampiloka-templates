{
  "name": "tampiloka-school-demo",
  "main": "dist-worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "school.tampiloka.site", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "DEMO_MODE": "true" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tampiloka-school-demo",
    "database_id": "5f81449b-a3c9-435d-bdae-ecf86d47ba89",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tampiloka-school-demo-media" }],
  "triggers": { "crons": ["0 3 * * *"] }
}
