# Production credentials are never included. Use pnpm demo for a local simulation.
DEMO_MODE=false
# AUTH_SECRET: generate 32+ random characters; use wrangler secret put.
# AUTH_SECRET=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# MIDTRANS_SERVER_KEY=
MIDTRANS_ENVIRONMENT=sandbox
# NOTIFICATION_URL=https://your-notification-adapter.example/events
# NOTIFICATION_SECRET=
# Generated provider choices are set in wrangler vars. Store credentials as secrets:
# TURSO_DATABASE_URL=libsql://...  TURSO_AUTH_TOKEN=...
# DATABASE_URL=postgresql://...
# S3_ENDPOINT=https://...  S3_BUCKET=...  S3_ACCESS_KEY_ID=...  S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto
# UPLOADTHING_TOKEN=...
