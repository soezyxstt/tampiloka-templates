{
  "name": "school-client",
  "main": "dist-worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "DEMO_MODE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-client",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "school-client-private"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
