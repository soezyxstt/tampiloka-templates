{
  "name": "tampiloka-templates",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cli": "node --test packages/cli/tests/*.test.mjs",
    "test:registry": "node --test packages/registry/tests/*.test.mjs",
    "catalog:build": "node scripts/build-public-catalog.mjs",
    "catalog:test": "node --test packages/registry/tests/public-catalog.test.mjs",
    "lint:design": "node scripts/check-design-tokens.mjs",
    "tampiloka": "node packages/cli/bin/tampiloka.mjs",
    "cli:pack": "pnpm --filter @tampiloka/cli pack",
    "dev:cafe": "pnpm --filter @tampiloka/template-cafe demos:dev",
    "dev:commerce": "pnpm --filter @tampiloka/template-commerce dev",
    "build:cafe": "pnpm --filter @tampiloka/template-cafe demos:build",
    "build:commerce": "pnpm --filter @tampiloka/template-commerce build",
    "verify": "pnpm test:cli && pnpm test:registry && pnpm --filter @tampiloka/template-commerce test && pnpm typecheck && pnpm build:commerce && pnpm build:cafe && pnpm test:school && pnpm build:school",
    "dev:school": "pnpm --filter @tampiloka/template-school demo",
    "build:school": "pnpm --filter @tampiloka/template-school build",
    "test:school": "pnpm --filter @tampiloka/template-school test",
    "test:school:browser": "pnpm --filter @tampiloka/template-school test:e2e",
    "dev:booking": "pnpm --filter @tampiloka/template-booking dev",
    "build:booking": "pnpm --filter @tampiloka/template-booking build:demo",
    "test:booking": "pnpm --filter @tampiloka/template-booking test",
    "test:booking:standalone": "node packages/cli/tests/booking-standalone.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "5.9.3"
  }
}
