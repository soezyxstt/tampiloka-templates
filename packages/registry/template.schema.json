{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tampiloka template manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "status"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["available", "planned"] },
    "description": { "type": "string" },
    "defaultPreset": { "type": "string" },
    "defaultLevel": { "type": "string" },
    "presets": { "type": "array", "items": { "type": "string" } },
    "levels": { "type": "array", "items": { "type": "string" } },
    "layouts": { "$ref": "#/$defs/axisIds" },
    "palettes": { "$ref": "#/$defs/axisIds" },
    "sharedPackages": { "type": "array", "items": { "type": "string" } },
    "demoUrl": { "type": "string", "format": "uri" }
  },
  "additionalProperties": false,
  "$defs": {
    "axisIds": {
      "description": "Unique lowercase, hyphen-separated IDs for independent appearance options.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
    }
  }
}
