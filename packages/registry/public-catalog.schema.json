{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.tampiloka.site/public-catalog.schema.json",
  "title": "Tampiloka public demo catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "families", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "families": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/family" } },
    "entries": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 },
    "text": {
      "type": "object", "additionalProperties": false, "required": ["id", "en"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "en": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
    "mode": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "family": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "modes": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/mode" } },
        "defaultMode": { "$ref": "#/$defs/id" }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "family", "name", "description", "url", "imageUrl", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "family": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "imageUrl": { "$ref": "#/$defs/httpsUrl" },
        "visibility": { "const": "public" },
        "modeUrls": {
          "type": "object", "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/httpsUrl" }
        },
        "featured": { "type": "boolean" }
      }
    }
  }
}
